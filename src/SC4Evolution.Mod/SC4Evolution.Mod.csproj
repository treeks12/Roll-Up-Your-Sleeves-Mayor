<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SC4Evolution</AssemblyName>
    <Version>0.5.1</Version>
    <Description>SC4Evolution municipal experience for Cities Skylines 1.</Description>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(CitiesSkylinesPath)/Cities_Data/Managed</GameManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SC4Evolution.Core/SC4Evolution.Core.csproj" />
    <ProjectReference Include="../SC4Evolution.Simulation/SC4Evolution.Simulation.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="ICities"><HintPath>$(GameManagedPath)/ICities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedPath)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ColossalManaged"><HintPath>$(GameManagedPath)/ColossalManaged.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedPath)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CitiesHarmony.Harmony"><HintPath>../../tools/CitiesHarmony/provider/CitiesHarmony/CitiesHarmony.Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CitiesHarmony.API"><HintPath>../../tools/CitiesHarmony/api/2.2.0/lib/net35/CitiesHarmony.API.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedPath)/ICities.dll')" Text="CS1 game references not found. Run scripts/Build.ps1 with config/local.paths.json configured." />
  </Target>
  <Target Name="ExcludeGameRuntimeCopies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.FullPath)').StartsWith('$(GameManagedPath)', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
  </Target>
</Project>
